{
  "uid": "coursework-use",
  "title": "Coursework: USE + HTTP",
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "schemaVersion": 39,
  "panels": [
    {"type": "timeseries", "title": "CPU utilization, %", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))"}],
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "timeseries", "title": "CPU saturation: load1 per core", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "node_load1 / on (instance) count by (instance) (node_cpu_seconds_total{mode=\"idle\"})"}],
     "fieldConfig": {"defaults": {"unit": "none", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 1}]}}, "overrides": []}},
    {"type": "timeseries", "title": "RAM utilization, %", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"}],
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "timeseries", "title": "RAM saturation: major page faults/s", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "rate(node_vmstat_pgmajfault[5m])"}],
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 200}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Disk utilization (/), %", "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})"}],
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Disk saturation: avg I/O queue", "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}} {{device}}",
       "expr": "rate(node_disk_io_time_weighted_seconds_total{device=~\"vd.*\"}[5m])"}],
     "fieldConfig": {"defaults": {"unit": "none", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Disk errors: filesystem device errors", "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "node_filesystem_device_error{mountpoint=\"/\"}"}],
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Network utilization: traffic", "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "legendFormat": "{{instance}} rx", "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[5m]))"},
       {"refId": "B", "legendFormat": "{{instance}} tx", "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[5m]))"}],
     "fieldConfig": {"defaults": {"unit": "Bps", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10000000}, {"color": "red", "value": 50000000}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Network saturation: dropped packets/s", "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "sum by (instance) (rate(node_network_receive_drop_total{device!=\"lo\"}[5m]) + rate(node_network_transmit_drop_total{device!=\"lo\"}[5m]))"}],
     "fieldConfig": {"defaults": {"unit": "pps", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Network errors: errors/s", "gridPos": {"x": 16, "y": 24, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "sum by (instance) (rate(node_network_receive_errs_total{device!=\"lo\"}[5m]) + rate(node_network_transmit_errs_total{device!=\"lo\"}[5m]))"}],
     "fieldConfig": {"defaults": {"unit": "pps", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []}},
    {"type": "timeseries", "title": "HTTP responses/s by status (http_response_count_total)", "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "legendFormat": "{{instance}} {{status}}", "expr": "sum by (instance, status) (rate(nginx_http_response_count_total[5m]))"},
       {"refId": "B", "legendFormat": "5xx errors", "expr": "sum(rate(nginx_http_response_count_total{status=~\"5..\"}[5m])) or vector(0)"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 100}]}}, "overrides": []}},
    {"type": "timeseries", "title": "HTTP response size, bytes/s (http_response_size_bytes)", "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{instance}}",
       "expr": "sum by (instance) (rate(nginx_http_response_size_bytes[5m]))"}],
     "fieldConfig": {"defaults": {"unit": "Bps", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1000000}, {"color": "red", "value": 5000000}]}}, "overrides": []}}
  ]
}
